---
import '../styles/site.css'
const {
  title = 'Oculivo | The operating system for modern eye care',
  description = 'Oculivo connects clinical, optical, communication, scheduling, billing, staff operations, website and SEO workflows for modern eye-care practices.'
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="theme-color" content="#0b0b22" />
  <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Oculivo" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WR6GGVYLXX"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WR6GGVYLXX');
  </script>
  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window,document,'clarity','script','yguz2tkhnt');
  </script>
</head>
<body>
<header class="site-header">
  <nav class="wrap site-nav">
    <a class="oculivo-logo" href="/" aria-label="Oculivo home">
      <svg viewBox="0 0 64 44" aria-hidden="true"><path d="M3 22C11 7 25 1 32 1c11 0 22 7 29 21-8 14-20 21-29 21C19 43 10 36 3 22Z" fill="#6b22ff"/><path d="M14 22C20 10 27 7 34 7c9 0 17 6 23 15-6 10-14 15-23 15-9 0-15-5-20-15Z" fill="#04b9ff"/><circle cx="33" cy="22" r="10" fill="#11113b"/><circle cx="33" cy="22" r="5.4" fill="#8a58ff"/><circle cx="36" cy="18" r="2.2" fill="#d7f6ff"/></svg>
      <span class="oculivo-word">OCUL<b>IVO</b></span>
    </a>
    <div class="main-links">
      <a href="/optometry-software">Optometry</a>
      <a href="/ophthalmology-software">Ophthalmology</a>
      <a href="/optical-management">Optical</a>
      <a href="/communications/">Communications</a>
      <a href="/website-seo/">Website + SEO</a>
      <a href="/pricing/">Pricing</a>
      <a href="/locations/">Nationwide</a>
    </div>
    <a class="nav-demo" href="https://taxrescrm.app/book?product=oculivo">Book a demo&nbsp; →</a>
  </nav>
</header>
<slot />
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="oculivo-logo" href="/">
        <svg viewBox="0 0 64 44" aria-hidden="true"><path d="M3 22C11 7 25 1 32 1c11 0 22 7 29 21-8 14-20 21-29 21C19 43 10 36 3 22Z" fill="#6b22ff"/><path d="M14 22C20 10 27 7 34 7c9 0 17 6 23 15-6 10-14 15-23 15-9 0-15-5-20-15Z" fill="#04b9ff"/><circle cx="33" cy="22" r="10" fill="#11113b"/><circle cx="33" cy="22" r="5.4" fill="#8a58ff"/></svg>
        <span class="oculivo-word">OCUL<b>IVO</b></span>
      </a>
      <div class="footer-copy">The operating system for modern eye care.<br/>Built by RomyLabs.</div>
    </div>
    <div class="footer-col"><strong>Platform</strong><a href="/optometry-software">Optometry software</a><a href="/ophthalmology-software">Ophthalmology software</a><a href="/optical-management">Optical management</a><a href="/communications/">Communications</a></div>
    <div class="footer-col"><strong>Growth & trust</strong><a href="/website-seo/">Website + SEO</a><a href="/pricing/">Pricing</a><a href="/locations/">Nationwide coverage</a><a href="/privacy/">Privacy</a><a href="/demo/">Founding practice demo</a><a href="mailto:info@romylabs.com">Contact RomyLabs</a></div>
  </div>
</footer>
</body>
</html>