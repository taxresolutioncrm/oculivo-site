---
const {
  title = 'Oculivo | Eye Care Practice Management Software',
  description = 'Oculivo connects scheduling, patients, clinical workflows, optical operations, communications, billing, and team coordination for modern eye-care practices.'
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071827" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#102331;background:#f7fbfd}
      *{box-sizing:border-box}body{margin:0}a{color:inherit}.wrap{width:min(1160px,calc(100% - 32px));margin:auto}
      header{background:#071827;color:white;border-bottom:1px solid rgba(255,255,255,.08)}nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}
      .brand{font-size:24px;font-weight:850;letter-spacing:-.04em;text-decoration:none}.brand span{color:#59d5cf}
      .navlinks{display:flex;gap:20px;align-items:center;font-size:14px}.navlinks a{text-decoration:none;color:#d9e8ef}
      .btn{display:inline-flex;align-items:center;justify-content:center;border-radius:10px;padding:12px 18px;text-decoration:none;font-weight:750}
      .primary{background:#28b8b1;color:#042523}.secondary{border:1px solid #bfd6df;background:white}
      footer{margin-top:80px;padding:36px 0;background:#071827;color:#a9c0cb;font-size:14px}
      @media(max-width:760px){.navlinks a:not(.btn){display:none}.wrap{width:min(100% - 24px,1160px)}}
    </style>
  </head>
  <body>
    <header><nav class="wrap"><a class="brand" href="/">Ocul<span>ivo</span></a><div class="navlinks"><a href="/features/">Features</a><a href="/solutions/optometry/">Optometry</a><a href="/solutions/ophthalmology/">Ophthalmology</a><a href="/pricing/">Pricing</a><a class="btn primary" href="https://admin.romylabs.com/book?product=oculivo">Book a demo</a></div></nav></header>
    <slot />
    <footer><div class="wrap">© 2026 Oculivo · A RomyLabs product · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></div></footer>
  </body>
</html>
