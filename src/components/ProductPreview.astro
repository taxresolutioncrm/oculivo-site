---
type Variant = 'dashboard'|'schedule'|'patients'|'reports'
const {variant='dashboard'}=Astro.props as {variant?:Variant}
const nav=[['▦','Overview'],['▣','Schedule'],['♙','Patients'],['◉','Clinical'],['◇','Optical'],['▤','Billing'],['▥','Reports']]
const active=variant==='schedule'?'Schedule':variant==='patients'?'Patients':variant==='reports'?'Reports':'Overview'
const sampleNames=['Sample Patient A','Sample Patient B','Sample Patient C']
---
<div class="oc-preview" role="img" aria-label={variant==='dashboard'?'Oculivo CRM dashboard interface illustration':variant==='schedule'?'Oculivo appointment scheduling interface illustration':variant==='patients'?'Oculivo patient profile interface illustration':'Oculivo reporting interface illustration'}>
  <div class="oc-preview-browser"><div class="oc-preview-dots"><i></i><i></i><i></i></div><span>OCULIVO / PRACTICE WORKSPACE</span><span class="oc-preview-demo">SAMPLE INTERFACE</span></div>
  <div class="oc-preview-app">
    <aside class="oc-preview-sidebar"><div class="oc-preview-logo"><span>◉</span> OCULIVO</div><div class="oc-preview-practice">Eye-care practice</div><div class="oc-preview-nav">{nav.map(([icon,name])=><div class:list={['oc-preview-navitem',{'selected':active===name}]}><span>{icon}</span><span>{name}</span></div>)}</div></aside>
    <div class="oc-preview-content">
      <div class="oc-preview-top"><div><small>Workspace / {active}</small><strong>{variant==='dashboard'?'Practice overview':variant==='schedule'?'Scheduling & appointments':variant==='patients'?'Patient profiles':'Practice reporting'}</strong></div><span class="oc-preview-circle">OP</span></div>
      {variant==='dashboard'&&<>
        <div class="oc-preview-metrics"><div><small>Appointments</small><strong>Calendar</strong><span>Provider schedules</span></div><div><small>Patients</small><strong>Records</strong><span>Clinical history</span></div><div><small>Optical</small><strong>Orders</strong><span>Inventory</span></div></div>
        <div class="oc-preview-grid"><div class="oc-preview-panel"><h3>Upcoming appointments</h3>{sampleNames.map((name,i)=><div class="oc-preview-line"><span class="oc-preview-time">{['9:00','10:30','1:15'][i]}</span><b>{name}</b><em>{['Scheduled','Confirmed','Follow-up'][i]}</em></div>)}</div><div class="oc-preview-panel"><h3>Practice workflow</h3><div class="oc-preview-barlabels"><span>Scheduling</span><span>Clinical</span><span>Optical</span><span>Billing</span></div><div class="oc-preview-bars"><i></i><i></i><i></i><i></i></div><small>Linked operational modules</small></div></div>
      </>}
      {variant==='schedule'&&<>
        <div class="oc-preview-subhead"><strong>Weekly calendar</strong><span>Today · Week view</span></div><div class="oc-preview-week">{['MON','TUE','WED','THU','FRI'].map((day,i)=><div class="oc-preview-day"><b>{day}</b><small>{i+10}</small>{[0,1,2].slice(0,i%2===0?2:3).map((k)=><div class:list={['oc-preview-event',{'aqua':k===1}]}><strong>{['9:00','11:30','2:15'][k]}</strong><span>{sampleNames[(i+k)%3]}</span></div>)}</div>)}</div>
      </>}
      {variant==='patients'&&<>
        <div class="oc-preview-profile"><div class="oc-preview-avatar">SP</div><div><strong>Sample Patient</strong><small>Patient overview · Example data</small></div><span class="oc-preview-tag">Active</span></div>
        <div class="oc-preview-metrics"><div><small>Appointments</small><strong>History</strong><span>Visit details</span></div><div><small>Clinical</small><strong>Records</strong><span>Exam notes</span></div><div><small>Documents</small><strong>Files</strong><span>Secure records</span></div></div><div class="oc-preview-grid"><div class="oc-preview-panel"><h3>Appointment history</h3><div class="oc-preview-line"><b>Annual eye exam</b><em>Completed</em></div><div class="oc-preview-line"><b>Follow-up visit</b><em>Scheduled</em></div></div><div class="oc-preview-panel"><h3>Related workflows</h3><div class="oc-preview-line"><b>Optical orders</b><em>View</em></div><div class="oc-preview-line"><b>Billing & documents</b><em>View</em></div></div></div>
      </>}
      {variant==='reports'&&<>
        <div class="oc-preview-metrics"><div><small>Practice</small><strong>Patients</strong><span>Records</span></div><div><small>Operations</small><strong>Visits</strong><span>Appointments</span></div><div><small>Financial</small><strong>Invoices</strong><span>Billing records</span></div></div><div class="oc-preview-panel oc-preview-report"><h3>Records by workflow</h3>{['Patients','Appointments','Optical orders','Invoices'].map((x,i)=><div class="oc-preview-reportline"><strong>{x}</strong><span><i style={'width:'+([88,71,52,63][i])+'%'}></i></span></div>)}<small>Visual example; not live practice data</small></div>
      </>}
    </div>
  </div>
</div>
<style>
.oc-preview{font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:#fff;border:1px solid #ccd3e7;border-radius:16px;overflow:hidden;box-shadow:0 26px 65px rgba(25,27,67,.17);color:#1c2541;min-width:0}
.oc-preview-browser{height:38px;background:#f2f3fa;border-bottom:1px solid #dde0eb;display:flex;align-items:center;gap:13px;padding:0 16px;font-size:9px;letter-spacing:.08em;font-weight:800;color:#677186}.oc-preview-dots{display:flex;gap:5px}.oc-preview-dots i{height:7px;width:7px;border-radius:50%;background:#bbbddd}.oc-preview-dots i:first-child{background:#eb8485}.oc-preview-dots i:nth-child(2){background:#efc66d}.oc-preview-dots i:nth-child(3){background:#7bd0aa}.oc-preview-demo{margin-left:auto;font-size:8px;color:#714ec5}
.oc-preview-app{display:grid;grid-template-columns:138px minmax(0,1fr);min-height:355px}
.oc-preview-sidebar{background:#13152f;color:#c8c4e5;padding:17px 10px}.oc-preview-logo{font-size:14px;font-weight:900;color:#8c61ff;letter-spacing:-.025em}.oc-preview-logo span{color:#30d6d8}.oc-preview-practice{font-size:9px;color:#9cabc9;border-top:1px solid #303454;padding:15px 5px;margin-top:16px}.oc-preview-nav{display:grid;gap:5px}.oc-preview-navitem{padding:9px 8px;display:flex;gap:9px;font-size:10px;border-radius:6px;align-items:center}.oc-preview-navitem span:first-child{font-size:14px}.oc-preview-navitem.selected{background:#49309e;color:#fff}
.oc-preview-content{padding:17px;background:#f8f9fd;min-width:0}.oc-preview-top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:17px}.oc-preview-top small{display:block;color:#7b849b;font-size:9px;margin-bottom:4px}.oc-preview-top strong{display:block;font-size:18px;letter-spacing:-.04em}.oc-preview-circle{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#e7e0ff;color:#6342cd;font-size:10px;font-weight:900}
.oc-preview-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:12px}.oc-preview-metrics>div{background:#fff;border:1px solid #e1e5ef;border-radius:8px;padding:13px 10px}.oc-preview-metrics small{display:block;font-size:9px;color:#67718d}.oc-preview-metrics strong{display:block;font-size:16px;color:#4931b1;margin:5px 0}.oc-preview-metrics span{font-size:8px;color:#707d8d}
.oc-preview-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:10px}.oc-preview-panel{border:1px solid #e1e5ef;background:#fff;border-radius:8px;padding:14px;min-width:0}.oc-preview-panel h3{font-size:12px;letter-spacing:-.02em;margin:0 0 13px;color:#202a48}.oc-preview-line{display:flex;gap:8px;align-items:center;border-top:1px solid #edf0f5;padding:10px 0;font-size:9px}.oc-preview-line b{font-weight:700;flex:1;min-width:0}.oc-preview-time{color:#613fd6;font-weight:800}.oc-preview-line em{font-style:normal;background:#eee8ff;color:#6248b1;border-radius:5px;padding:4px 5px;font-size:8px}.oc-preview-barlabels{display:flex;flex-wrap:wrap;gap:10px;font-size:9px;color:#6d7890;margin:12px 0}.oc-preview-bars{display:flex;align-items:end;gap:8px;height:90px;border-bottom:1px solid #d3d7e7}.oc-preview-bars i{flex:1;height:62%;background:linear-gradient(#896cff,#d5c9ff);border-radius:5px 5px 0 0}.oc-preview-bars i:nth-child(2){height:86%}.oc-preview-bars i:nth-child(3){height:52%;background:linear-gradient(#41c7cb,#b2eeee)}.oc-preview-bars i:nth-child(4){height:71%}.oc-preview-panel>small{display:block;font-size:9px;color:#7b8294;margin-top:8px}
.oc-preview-subhead{display:flex;justify-content:space-between;margin-bottom:12px;font-size:11px}.oc-preview-subhead span{color:#6145b8}.oc-preview-week{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border:1px solid #e2e4ef;background:#fff;border-radius:8px;overflow:hidden}.oc-preview-day{min-height:250px;padding:9px 5px;border-right:1px solid #e5e7f0}.oc-preview-day:last-child{border-right:0}.oc-preview-day>b,.oc-preview-day>small{font-size:9px;display:block;text-align:center}.oc-preview-day>small{color:#8a8ca6;margin:5px 0 13px}.oc-preview-event{background:#ede8ff;border-left:3px solid #6445de;border-radius:5px;padding:7px 4px;margin:8px 0;min-width:0}.oc-preview-event.aqua{background:#e3f5f2;border-color:#21aab2}.oc-preview-event strong,.oc-preview-event span{display:block;font-size:8px;overflow-wrap:anywhere}.oc-preview-event span{margin-top:4px;color:#4d5871}
.oc-preview-profile{display:flex;gap:12px;align-items:center;background:#fff;border:1px solid #e1e5ef;border-radius:10px;padding:13px;margin-bottom:12px}.oc-preview-avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:#e7e0ff;color:#5d3cd7;font-weight:800}.oc-preview-profile strong{font-size:15px;display:block}.oc-preview-profile small{display:block;color:#717b90;font-size:9px;margin-top:3px}.oc-preview-tag{margin-left:auto;background:#dff6ee;border-radius:20px;color:#1e866a;font-size:9px;padding:6px 10px}
.oc-preview-reportline{display:flex;align-items:center;gap:12px;margin:15px 0}.oc-preview-reportline strong{width:110px;font-size:10px}.oc-preview-reportline>span{height:12px;background:#eee9fd;flex:1;border-radius:10px;overflow:hidden}.oc-preview-reportline i{display:block;height:100%;border-radius:10px;background:linear-gradient(90deg,#6541d8,#33c0ca)}
@media(max-width:500px){.oc-preview-app{grid-template-columns:88px minmax(0,1fr);min-height:310px}.oc-preview-sidebar{padding:14px 5px}.oc-preview-logo{font-size:10px}.oc-preview-practice{font-size:7px}.oc-preview-navitem{font-size:8px;padding:7px 3px;gap:4px}.oc-preview-navitem span:first-child{font-size:10px}.oc-preview-content{padding:9px}.oc-preview-top strong{font-size:14px}.oc-preview-metrics{gap:4px}.oc-preview-metrics>div{padding:8px 5px}.oc-preview-metrics strong{font-size:12px}.oc-preview-grid{grid-template-columns:1fr}.oc-preview-grid .oc-preview-panel:last-child{display:none}.oc-preview-browser{font-size:7px;padding:0 8px}.oc-preview-day{padding:5px 2px;min-height:165px}.oc-preview-event{padding:5px 2px}.oc-preview-event strong,.oc-preview-event span{font-size:7px}.oc-preview-profile{padding:8px}.oc-preview-reportline strong{width:67px}}
</style>
