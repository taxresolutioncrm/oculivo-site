---
const {src,alt,eyebrow='A PRACTICE BUILT AROUND PATIENTS',position='center',credit=''} = Astro.props as {src:string;alt:string;eyebrow?:string;position?:string;credit?:string}
---
<section class="oc-page-photo-band" aria-label="Eye care in practice">
  <div class="wrap oc-page-photo-wrap">
    <div class="oc-page-photo-frame">
      <img src={src} alt={alt} width="1400" height="770" loading="eager" decoding="async" style={`object-position:${position}`}/>
      <span class="oc-page-photo-label"><span class="oc-photo-point"></span>{eyebrow}</span>
    </div>
  </div>
</section>
<style>
.oc-page-photo-band{background:#f4f5f9;padding:0 0 45px;margin-top:-1px}
.oc-page-photo-wrap{max-width:1250px}
.oc-page-photo-frame{position:relative;overflow:hidden;border-radius:15px;background:#dce2e8;aspect-ratio:2.25;box-shadow:0 18px 48px rgba(14,26,49,.12)}
.oc-page-photo-frame>img{width:100%;height:100%;object-fit:cover;display:block}
.oc-page-photo-label{display:inline-flex;gap:10px;align-items:center;position:absolute;bottom:20px;left:22px;padding:12px 16px;border-radius:6px;background:rgba(17,23,44,.91);color:#fff;font-size:10px;font-weight:800;letter-spacing:.09em;line-height:1.4}
.oc-photo-point{width:7px;height:7px;border-radius:50%;background:#5fe1de;flex-shrink:0}
@media(max-width:800px){.oc-page-photo-frame{aspect-ratio:1.6}.oc-page-photo-label{left:12px;bottom:12px;font-size:9px;padding:10px 12px}}
@media(max-width:550px){.oc-page-photo-frame{aspect-ratio:1.15;border-radius:11px}.oc-page-photo-band{padding-bottom:28px}}
</style>
