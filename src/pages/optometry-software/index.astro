  {"@context":"https://schema.org","@type":"SoftwareApplication","name":"Oculivo","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://oculivo.com/optometry-software/","description":"Cloud-based optometry practice management software connecting scheduling, patients, clinical workflows, optical operations, billing, communications and reporting."},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
