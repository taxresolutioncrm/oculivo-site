---
import Base from '../../layouts/Base.astro'
---
<Base title="Private Oculivo Demo | Founding Practice Program" description="Request a private Oculivo walkthrough tailored to your eye-care practice.">
<main class="hero-dark demo-page">
  <div class="wrap demo-grid">
    <section>
      <span class="eyebrow demo-purple">Private founding-practice demo</span>
      <h1>See what your<br/>practice looks like<br/>when everything<br/>connects.</h1>
      <p>We’ll tailor the walkthrough to your specialty, locations, team, communication stack, optical operations, and growth goals.</p>
      <ul><li>✓&nbsp;&nbsp;A realistic, eye-care-specific product walkthrough</li><li>✓&nbsp;&nbsp;Workflow and integration discovery</li><li>✓&nbsp;&nbsp;Founding-practice onboarding discussion</li><li>✓&nbsp;&nbsp;English and Spanish workflow planning</li></ul>
    </section>
    <aside class="demo-card">
      <div class="demo-icon">✣</div>
      <span class="eyebrow">Your private walkthrough</span>
      <h2>Start the conversation.</h2>
      <p>Tell us which type of eye-care practice you operate and what you want Oculivo to replace or improve.</p>
      <a class="btn-grad demo-email" href="https://taxrescrm.app/book?product=oculivo">▣&nbsp;&nbsp;Book your Oculivo demo&nbsp;&nbsp; →</a>
      <small>Direct founding-practice access. No generic sales queue.</small>
    </aside>
  </div>
</main>
<style>
.demo-page{padding:110px 0 120px;min-height:760px}.demo-grid{display:grid;grid-template-columns:1.2fr .85fr;gap:92px;align-items:center}.demo-purple{color:#825cff}.demo-page h1{font-size:clamp(58px,6vw,82px);line-height:.91;letter-spacing:-.055em;font-weight:500;margin:28px 0 24px}.demo-page section>p{font-size:17px;line-height:1.7;color:#c7c3dc;max-width:680px}.demo-page ul{list-style:none;padding:0;margin:34px 0 0;display:grid;gap:20px;color:#fff;font-size:14px}.demo-page li{color:#f4f2ff}.demo-page li::first-letter{color:#25d8d3}.demo-card{background:#261c64;border:1px solid #5849a0;border-radius:26px;padding:38px;min-height:465px}.demo-icon{width:56px;height:56px;border-radius:17px;background:linear-gradient(135deg,#2fd7d4,#8e8af4,#d64ccb);display:grid;place-items:center;color:#11122d;font-size:30px;margin-bottom:42px}.demo-card h2{font-size:30px;font-weight:500;margin:28px 0 18px}.demo-card p{font-size:17px;line-height:1.75;color:#c6c0df}.demo-email{margin-top:20px;width:100%;justify-content:space-between}.demo-card small{display:block;margin-top:18px;color:#aaa3c9;font-size:13px}@media(max-width:900px){.demo-grid{grid-template-columns:1fr}.demo-page h1 br{display:none}}
</style>