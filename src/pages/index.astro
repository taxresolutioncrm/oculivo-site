---
import Base from '../layouts/Base.astro'
const schema={"@context":"https://schema.org","@type":"SoftwareApplication","name":"Oculivo","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://oculivo.com/","description":"The operating system for modern eye care."}
---
<Base>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
  <section class="hero"><div class="wrap hero-grid">
    <div><span class="eyebrow">One connected eye-care platform</span><h1>The operating system for modern eye care.</h1><p>Oculivo connects scheduling, patients, clinical workflows, optical, communications, billing, staff operations, website, SEO, and reporting in one practice-wide system.</p><div class="actions"><a class="primary" href="https://taxrescrm.app/book?product=oculivo">Request a private demo&nbsp; →</a><a class="secondary" href="/website-seo/">Explore Oculivo</a></div></div>
    <div class="hero-card"><span>OCULIVO CORE CONNECT</span><h2>One patient record.<br/>One connected practice.</h2><div class="stack"><b>Schedule + intake</b><b>Clinical + optical</b><b>Communications + billing</b><b>Team + growth</b></div></div>
  </div></section>
  <section class="depth"><div class="wrap"><div class="head"><span class="eyebrow cyan">Purpose-built for eye care</span><div><h2>Purpose-built depth.<br/>Practice-wide clarity.</h2><p>Every Oculivo workflow connects back to the same practice context so teams can move from front desk to clinical to optical to billing without rebuilding the patient story.</p></div></div><div class="cards"><article><span>01</span><h3>Clinical operations</h3><p>Scheduling, patients, providers, clinical records, documents and care workflows stay connected.</p></article><article><span>02</span><h3>Optical + communications</h3><p>Optical orders, inventory, inbox, calls, messages and patient follow-up live in the same operating system.</p></article><article><span>03</span><h3>Growth + practice intelligence</h3><p>Billing, reporting, website, local SEO and patient acquisition data connect to actual practice operations.</p></article></div></div></section>
  <section class="founding"><div class="wrap"><div class="founding-card"><div><span class="eyebrow cyan">Founding practice program</span><h2>Build the clearer future of eye care with us.</h2><p>Get a private walkthrough and help shape Oculivo around the workflows your practice actually uses.</p></div><a href="https://taxrescrm.app/book?product=oculivo">Request your private demo&nbsp; →</a></div></div></section>
</main>
</Base>
<style>
.hero{background:radial-gradient(circle at 75% 26%,rgba(97,63,230,.24),transparent 30%),#0b0b22;color:white;padding:96px 0 90px}.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center;min-height:560px}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:11px;font-weight:900;color:#8b69ff}.hero h1{font-size:clamp(58px,7vw,88px);line-height:.96;letter-spacing:-.06em;margin:24px 0}.hero p{font-size:18px;line-height:1.7;color:#c3bfd7;max-width:720px}.actions{display:flex;gap:12px;margin-top:32px}.actions a{display:inline-flex;text-decoration:none;border-radius:12px;padding:14px 20px;font-weight:850;font-size:14px}.primary{background:linear-gradient(90deg,#2fd8d4,#9384f4);color:#0a0a20}.secondary{border:1px solid #423e5d;color:white}.hero-card{background:#241a60;border:1px solid #55479c;border-radius:28px;padding:36px;min-height:420px;box-shadow:0 32px 85px rgba(0,0,0,.32)}.hero-card>span{font-size:11px;letter-spacing:.13em;color:#51d9e5;font-weight:900}.hero-card h2{font-size:38px;line-height:1.04;letter-spacing:-.04em;margin:34px 0}.stack{display:grid;gap:14px;padding-top:24px;border-top:1px solid rgba(255,255,255,.12)}.stack b{font-size:15px;color:#dcd8ef}
.depth{background:#f8f8fc;padding:80px 0}.head{display:grid;grid-template-columns:.95fr 1.05fr;gap:70px}.cyan{color:#2bd8d2}.head h2{font-size:clamp(48px,5vw,66px);font-weight:500;line-height:.98;letter-spacing:-.055em;margin:0 0 24px}.head p{font-size:17px;line-height:1.7;color:#6b6880}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}.cards article{background:white;border:1px solid #dedee9;border-radius:20px;padding:30px;min-height:245px}.cards span{font-size:12px;color:#7c58ef;font-weight:900}.cards h3{font-size:22px;font-weight:500;margin:38px 0 12px}.cards p{color:#68667d;line-height:1.65;font-size:14px}.founding{background:#f8f8fc;padding:8px 0 90px}.founding-card{background:linear-gradient(110deg,#3b276d,#18152f 58%,#104552);border-radius:28px;color:white;padding:62px 66px;display:flex;align-items:flex-end;justify-content:space-between;gap:40px}.founding-card h2{font-size:clamp(44px,5vw,62px);line-height:1.02;letter-spacing:-.05em;font-weight:500;max-width:760px;margin:18px 0}.founding-card p{color:#d7d4e7;font-size:17px}.founding-card>a{background:white;color:#0a0a1e;text-decoration:none;border-radius:12px;padding:16px 22px;font-weight:900;white-space:nowrap}
@media(max-width:900px){.hero-grid,.head,.cards{grid-template-columns:1fr}.founding-card{flex-direction:column;align-items:flex-start}}
</style>