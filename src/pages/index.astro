---
import Base from '../layouts/Base.astro'
import ProductPreview from '../components/ProductPreview.astro'
const schema={
  '@context':'https://schema.org','@type':'SoftwareApplication',
  'name':'Oculivo','applicationCategory':'BusinessApplication','operatingSystem':'Web',
  'url':'https://oculivo.com/',
  'description':'Eye-care practice management software for optometry, ophthalmology and optical operations.',
  'offers':{'@type':'AggregateOffer','priceCurrency':'USD','lowPrice':'399','highPrice':'799','offerCount':'3'},
  'publisher':{'@type':'Organization','name':'RomyLabs','url':'https://romylabs.com/'}
}
const specialties=[
  {number:'01',name:'OPTOMETRY',headline:'One smoother day, from exam room to optical.',description:'Scheduling, patient records, optical orders, billing and front-desk coordination in one practice context.',href:'/optometry-software/',cta:'Explore optometry workflows'},
  {number:'02',name:'OPHTHALMOLOGY',headline:'Give specialty care the operational clarity it deserves.',description:'Keep provider schedules, clinical context, referrals, documents, billing and team handoffs connected.',href:'/ophthalmology-software/',cta:'Explore ophthalmology workflows'},
  {number:'03',name:'OPTICAL',headline:'Inventory that stays connected to the patient.',description:'Keep frames, lenses, vendors, orders, receiving and dispensing within the eye-care workflow.',href:'/optical-management/',cta:'Explore optical management'}
]
const plans=[
  {label:'Core',price:'$399',copy:'The connected foundation for everyday practice operations.',features:'Scheduling · Patients · Clinical · Billing'},
  {label:'Professional',price:'$599',copy:'Connect the optical team, communications and expanded workflows.',features:'Core + Optical · Communications · Reporting'},
  {label:'Complete',price:'$799',copy:'Broader operations with higher-touch rollout support.',features:'Professional + Expanded operations'}
]
---
<Base title="Optometry Practice Management Software | Oculivo" description="See Oculivo optometry software for scheduling, patient records, optical orders and billing. Plans start at $399 per location. Book a private demo." schema={schema}>
<main class="oc-home">
  <section class="oc-hero2" aria-labelledby="oc-headline">
    <div class="wrap oc-hero2-intro">
      <div class="oc-hero2-copy">
        <p class="oc-hero2-overline"><span aria-hidden="true" class="oc-hero2-pulse"></span> THE PRACTICE PLATFORM FOR EYE CARE</p>
        <h1 id="oc-headline">Run your eye-care practice <em>with more clarity.</em></h1>
        <p class="oc-hero2-keyword">Optometry &amp; ophthalmology practice management software</p>
        <p class="oc-hero2-description">Scheduling, patient records, optical orders, billing and follow-up — connected in one workspace built specifically for optometry and ophthalmology teams.</p>
        <div class="oc-hero2-actions"><a href="/demo/" class="oc-hero2-primary">Book your private demo <span aria-hidden="true">↗</span></a><a href="/pricing/" class="oc-hero2-secondary">See pricing and plans <span aria-hidden="true">→</span></a></div>
        <p class="oc-hero2-rate"><strong>Plans from $399/month</strong><span>per practice location · <a href="/pricing/">Compare all three plans</a></span></p>
      </div>
      <div class="oc-hero-photo">
        <img src="/images/oculivo-hero.webp" alt="Smiling optometrist examining a patient with a slit-lamp microscope in a modern eye-care practice" width="720" height="405" fetchpriority="high" decoding="async"/>
        <div class="oc-hero-photo-tag"><span class="oc-hero-photo-dot"></span> BUILT FOR REAL EYE-CARE WORKFLOWS</div>
      </div>
    </div>
    <div class="wrap oc-hero2-bottom"><span>BUILT SPECIFICALLY FOR EYE-CARE PRACTICES</span><span>OPTOMETRY <span aria-hidden="true">/</span> OPHTHALMOLOGY <span aria-hidden="true">/</span> OPTICAL</span></div>
  </section>

  <section class="oc-product-feature" aria-labelledby="oc-product-feature-title">
    <div class="wrap oc-product-feature-shell">
      <div class="oc-product-feature-heading">
        <div><p class="oc-label-dark">MEET OCULIVO</p><h2 id="oc-product-feature-title">The software behind your practice.</h2><p>See a preview of the connected workspace behind your day-to-day operations, from appointments to patient care and billing.</p></div>
        <a href="/demo/">See Oculivo in a live demo <span aria-hidden="true">↗</span></a>
      </div>
      <div class="oc-product-feature-visual"><ProductPreview variant="dashboard"/><p class="oc-product-label">Illustrative Oculivo interface preview with sample information — the private demo shows the working product.</p></div>
    </div>
  </section>

  <section class="oc-showcase" id="inside-oculivo" aria-labelledby="oc-showcase-heading">
    <div class="wrap oc-showcase-head">
      <div><p class="oc-label-dark">INSIDE THE PLATFORM</p><h2 id="oc-showcase-heading">See the software behind the practice.</h2><p>Get a closer look at scheduling, patient management, and practice reporting. These interface previews use illustrative sample information; your private demo walks through the working CRM.</p></div>
      <a href="/demo/" class="oc-showcase-cta">Book a live walkthrough <span aria-hidden="true">↗</span></a>
    </div>
    <div class="wrap oc-showcase-stories">
      <article class="oc-showcase-story"><div class="oc-showcase-story-text"><span class="oc-showcase-number">01 / SCHEDULING</span><h3>Bring the whole week into view.</h3><p>See appointments by day, move between weeks, and open visit details without hunting through a list.</p><a href="/features/">Explore scheduling <span aria-hidden="true">→</span></a></div><ProductPreview variant="schedule"/></article>
      <article class="oc-showcase-story flipped"><div class="oc-showcase-story-text"><span class="oc-showcase-number">02 / PATIENTS</span><h3>A patient record that keeps context together.</h3><p>Clinical history, appointments, related optical work, documents and billing live within a connected practice workflow.</p><a href="/optometry-software/">Explore patient management <span aria-hidden="true">→</span></a></div><ProductPreview variant="patients"/></article>
      <article class="oc-showcase-story"><div class="oc-showcase-story-text"><span class="oc-showcase-number">03 / REPORTING</span><h3>Understand your practice without guesswork.</h3><p>Navigate operational reporting based on actual practice records. No invented performance claims or inflated demo numbers.</p><a href="/features/">Explore reports <span aria-hidden="true">→</span></a></div><ProductPreview variant="reports"/></article>
    </div>
  </section>

  <section class="oc-thin-intro" aria-labelledby="oc-clarity"><div class="wrap oc-thin-grid">
    <p class="oc-label-dark">THE BIGGER PICTURE <span>01 / 04</span></p>
    <div><h2 id="oc-clarity">Better visibility. <em>Less switching.</em></h2><p>Oculivo is built around how an eye-care practice actually operates: one patient, multiple teams, and a long chain of handoffs. Explore the workflows that matter without piecing together disconnected software.</p></div>
  </div></section>

  <section class="oc-specialties" aria-labelledby="oc-specialties-title"><div class="wrap">
    <div class="oc-section-heading"><p class="oc-label-dark">BUILT AROUND YOUR SPECIALTY <span>02 / 04</span></p><h2 id="oc-specialties-title">Eye care is not a generic business.</h2></div>
    <div class="oc-specialty-gallery">
      <a href="/optometry-software/" class="oc-specialty-photo-card">
        <div class="oc-specialty-image"><img src="/images/oculivo-reception-team.webp" alt="Eye-care reception team welcoming patients and reviewing their intake" width="800" height="650" loading="lazy" decoding="async"/></div>
        <div class="oc-specialty-photo-info"><span>01 / OPTOMETRY</span><h3>From reception to exam room.</h3><p>Scheduling, patients, documentation and team coordination in one eye-care workflow.</p><strong>Explore optometry <span aria-hidden="true">↗</span></strong></div>
      </a>
      <a href="/ophthalmology-software/" class="oc-specialty-photo-card">
        <div class="oc-specialty-image"><img src="/images/oculivo-ophthalmology.webp" alt="Ophthalmology clinician consulting with a patient in a modern eye-care exam room" width="800" height="650" loading="lazy" decoding="async"/></div>
        <div class="oc-specialty-photo-info"><span>02 / OPHTHALMOLOGY</span><h3>Clarity across specialty care.</h3><p>Connect provider schedules, patient information, clinical workflows and practice operations.</p><strong>Explore ophthalmology <span aria-hidden="true">↗</span></strong></div>
      </a>
      <a href="/optical-management/" class="oc-specialty-photo-card">
        <div class="oc-specialty-image"><img src="/images/oculivo-optical.webp" alt="Optician assisting a patient with choosing eyeglass frames in an optical boutique" width="800" height="650" loading="lazy" decoding="async"/></div>
        <div class="oc-specialty-photo-info"><span>03 / OPTICAL</span><h3>Keep optical connected.</h3><p>Bring inventory, frames, orders and dispensing into the broader patient workflow.</p><strong>Explore optical management <span aria-hidden="true">↗</span></strong></div>
      </a>
    </div>
  </div></section>

  <section class="oc-process" aria-labelledby="oc-process-title"><div class="wrap oc-process-layout">
    <div class="oc-process-intro"><p class="oc-label-light">THE CONNECTED JOURNEY <span>03 / 04</span></p><h2 id="oc-process-title">From first visit to final follow-up.</h2><p>Every handoff is an opportunity to lose context. Explore how Oculivo brings the front desk, provider, optical desk and billing team into one workflow.</p><a href="/features/">Discover the platform <span aria-hidden="true">↗</span></a></div>
    <ol class="oc-process-list">
      <li><span>01</span><div><strong>Welcome &amp; schedule</strong><p>Appointments, providers, patients and intake</p></div></li>
      <li><span>02</span><div><strong>Examine &amp; document</strong><p>Clinical notes, records and care coordination</p></div></li>
      <li><span>03</span><div><strong>Select &amp; fulfill</strong><p>Frames, lenses, inventory and optical orders</p></div></li>
      <li><span>04</span><div><strong>Bill &amp; follow up</strong><p>Invoices, communications and reports</p></div></li>
    </ol>
  </div></section>

  <section class="oc-pricing" aria-labelledby="oc-pricing-title"><div class="wrap">
    <div class="oc-pricing-intro"><p class="oc-label-dark">TRANSPARENT PRICING <span>04 / 04</span></p><div><h2 id="oc-pricing-title">Clear prices.<br/><em>Clear next steps.</em></h2><p>No searching for the price. Compare three published Oculivo plans, then walk through your practice's actual requirements with us.</p></div></div>
    <div class="home-pricing-grid oc-price-grid">
      {plans.map((plan,i)=><article class:list={['oc-plan',{'oc-plan-middle':i===1}]}>
        <div><span class="oc-plan-index">0{i+1} / {plan.label.toUpperCase()}</span><h3>{plan.label}</h3><p>{plan.copy}</p></div>
        <div class="oc-plan-bottom"><div class="oc-plan-cost"><strong>{plan.price}</strong><span>/ month<br/>per location</span></div><small>{plan.features}</small><a href="/pricing/">View {plan.label} details <span aria-hidden="true">↗</span></a></div>
      </article>)}
    </div>
    <p class="oc-price-disclaimer">Implementation, migration, and provider-backed usage charges are scoped separately. See <a href="/pricing/">full pricing and terms</a> before deciding.</p>
  </div></section>

  <section class="oc-guides"><div class="wrap oc-guides-layout">
    <div><p class="oc-label-dark">DECIDE WITH CONFIDENCE</p><h2>Before you change systems, ask better questions.</h2><p>Start with practical evaluations of the workflows that matter to your practice.</p></div>
    <div class="oc-guide-links">
      <a href="/resources/optometry-software-buyers-guide/"><span>OPTOMETRY</span><strong>Software buyer's guide</strong><span aria-hidden="true">↗</span></a>
      <a href="/resources/ophthalmology-software-buyers-guide/"><span>OPHTHALMOLOGY</span><strong>Specialty practice buyer's guide</strong><span aria-hidden="true">↗</span></a>
      <a href="/resources/optical-inventory-management-guide/"><span>OPTICAL</span><strong>Inventory management guide</strong><span aria-hidden="true">↗</span></a>
      <a href="/resources/"><span>RESOURCES</span><strong>All eye-care resources</strong><span aria-hidden="true">↗</span></a>
    </div>
  </div></section>

  <section class="oc-final"><div class="wrap oc-final-grid"><div><p>LET'S TALK ABOUT YOUR PRACTICE</p><h2>See what a clearer workday could look like.</h2></div><a href="/demo/">Schedule your private demo <span aria-hidden="true">↗</span></a></div></section>
</main>
</Base>
<style>
.oc-home{--cream:#f8f7f2;--charcoal:#172137;--accent:#5433d7;--aqua:#0d8a98;font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:var(--cream);color:var(--charcoal)}
.oc-home h1,.oc-home h2,.oc-home h3{font-weight:650;letter-spacing:-.055em}.oc-home a{text-decoration:none}.oc-home a:focus-visible{outline:3px solid #2ac4ce;outline-offset:4px}
.oc-hero{position:relative;background:#f4f5f1;overflow:hidden;border-bottom:1px solid #d9e0de}
.oc-hero-wrap{display:grid;grid-template-columns:1.07fr .93fr;gap:32px;min-height:720px;align-items:center;padding-top:66px;padding-bottom:66px}
.oc-kicker{font-size:11px;font-weight:800;letter-spacing:.17em;color:#4a5260;display:flex;gap:12px;align-items:center}.oc-signal{width:9px;height:9px;background:#04a4aa;border-radius:50%;box-shadow:0 0 0 5px #d9f2ef}
.oc-hero h1{font-size:clamp(56px,5.9vw,88px);line-height:1.035;margin:29px 0 14px;max-width:720px}.oc-hero h1 em,.oc-thin-intro h2 em,.oc-pricing h2 em{font-style:normal;color:var(--accent)}
.oc-seo-line{font-size:12px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;color:#2a686d;margin:20px 0}
.oc-hero-intro{font-size:17px;line-height:1.75;max-width:610px;color:#566270;margin:0}
.oc-hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:13px;margin-top:30px}
.oc-primary{background:#262144;color:#fff;border-radius:4px;padding:18px 22px;font-size:13px;font-weight:800;display:inline-flex;gap:30px;align-items:center;justify-content:space-between;min-height:53px}.oc-primary:hover{background:#5538bb}
.oc-secondary{color:#1c2940;border:1px solid #abb7b7;border-radius:4px;padding:17px 21px;font-weight:800;font-size:13px;display:inline-flex;gap:30px;align-items:center}.oc-secondary:hover{background:#e5efeb}
.oc-price-anchor{margin-top:35px;display:flex;align-items:center;flex-wrap:wrap;gap:13px;border-top:1px solid #cfd8d5;padding-top:18px}.oc-price-kicker{font-size:9px;letter-spacing:.16em;color:#69777a;font-weight:900}.oc-price-anchor strong{font-size:18px;color:#211f48}.oc-price-anchor>span:last-child{font-size:12px;color:#64727b}
.oc-optic-scene{height:650px;position:relative;display:flex;justify-content:center;align-items:center;isolation:isolate}
.oc-orbit{position:absolute;border:1px solid #a9c6c6;border-radius:50%;width:570px;height:570px;transform:rotate(-20deg)}.oc-orbit-two{width:450px;height:450px;border-color:#c0d7d2;transform:rotate(23deg)}
.oc-eye-graphic{position:absolute;top:60px;right:0;width:315px;height:185px;border:25px solid #6b4af2;border-radius:75% 5% 75% 5%;transform:rotate(45deg);background:#a9f0e8;display:grid;place-items:center;opacity:.92;z-index:-1}
.oc-eye-inner{display:grid;place-items:center;width:128px;height:128px;border-radius:50%;background:#1ca9cf;border:18px solid #4a2fbc}.oc-eye-pupil{width:55px;height:55px;background:#141536;border-radius:50%;box-shadow:inset 12px 12px #3441a0}
.oc-scene-label{position:absolute;left:8px;top:68px;max-width:180px;font-size:11px;color:#6c8583;letter-spacing:.16em;font-weight:800;line-height:1.6}
.oc-interface{position:relative;width:min(440px,95%);margin-top:100px;background:white;border:1px solid #d6e0e1;border-radius:12px;box-shadow:0 26px 75px rgba(28,39,69,.17);overflow:hidden;transform:rotate(-3deg)}
.oc-interface-top{background:#1f2443;color:white;padding:16px 19px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700}.oc-interface-top i{display:inline-block;width:9px;height:9px;background:#3ee0d0;border-radius:50%;margin-right:8px}.oc-interface-top small{font-size:9px;font-weight:500;color:#bac1dd}
.oc-interface-body{padding:25px}.oc-interface-title{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e7e9eb;padding-bottom:21px}.oc-interface-title>span{font-size:25px;font-weight:750;letter-spacing:-.04em}.oc-interface-title b{font-size:9px;letter-spacing:.12em;color:#6151af}.oc-interface-rows{display:grid;gap:0}.oc-interface-rows>div{display:flex;align-items:center;gap:14px;padding:20px 0;border-bottom:1px solid #edf0f0}.oc-interface-rows>div>span:nth-child(2){flex:1}.oc-interface-number{font-size:11px;font-weight:800;color:#6550ba}.oc-interface-rows strong{display:block;font-size:13px}.oc-interface-rows small{font-size:11px;display:block;margin-top:5px;color:#75808f}
.oc-hero-bottom{display:flex;justify-content:space-between;border-top:1px solid #d6e0df;padding:21px 0;font-size:10px;letter-spacing:.14em;color:#556c6e;font-weight:800}
.oc-thin-intro{background:#fff;padding:105px 0}.oc-thin-grid{display:grid;grid-template-columns:.35fr 1fr;gap:65px;align-items:start}.oc-label-dark,.oc-label-light{font-size:10px;font-weight:850;letter-spacing:.16em;color:#456d6b;display:flex;gap:20px;justify-content:space-between;max-width:235px}.oc-label-light{color:#9ad7d5}
.oc-thin-intro h2,.oc-section-heading h2,.oc-process h2,.oc-pricing h2,.oc-guides h2,.oc-final h2{font-size:clamp(38px,4.7vw,65px);line-height:1.08;margin:0}.oc-thin-intro p:not(.oc-label-dark){font-size:18px;line-height:1.75;color:#62717c;max-width:730px}
.oc-specialties{background:#eaf0ed;padding:90px 0 110px}.oc-section-heading{display:grid;grid-template-columns:.35fr 1fr;gap:65px;align-items:start;margin-bottom:56px}
.oc-specialty-list{border-top:1px solid #bdcbc9}.oc-specialty-row{display:grid;grid-template-columns:185px 1fr 55px;gap:40px;border-bottom:1px solid #bdcbc9;padding:36px 8px 39px;color:inherit;align-items:start;transition:background .2s,padding .2s}.oc-specialty-row:hover{background:#dce9e3;padding-left:18px}.oc-specialty-number{font-size:11px;letter-spacing:.12em;font-weight:850;color:#417672}.oc-specialty-row h3{font-size:clamp(25px,3vw,40px);margin:0 0 10px;line-height:1.14}.oc-specialty-row p{font-size:14px;color:#5b6d72;max-width:660px;line-height:1.7;margin:0 0 16px}.oc-specialty-link{font-size:12px;font-weight:800;color:#4f35ad;text-decoration:underline;text-underline-offset:4px}.oc-specialty-arrow{font-size:29px;color:#4f35ad;text-align:right}
.oc-process{background:#19243a;color:#fff;padding:108px 0}.oc-process-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:105px}.oc-process h2{margin:30px 0}.oc-process-intro>p:not(.oc-label-light){max-width:455px;line-height:1.75;color:#bdcbd3;font-size:16px}.oc-process-intro>a{display:inline-flex;margin-top:25px;gap:24px;align-items:center;color:#8fe9e8;font-weight:800;border-bottom:1px solid #8fe9e8;padding-bottom:10px}.oc-process-list{padding:0;margin:0;list-style:none;counter-reset:none}.oc-process-list li{display:flex;align-items:flex-start;gap:22px;border-top:1px solid #47576a;padding:23px 0}.oc-process-list li:last-child{border-bottom:1px solid #47576a}.oc-process-list li>span{color:#8fe9e8;font-size:11px;font-weight:800;min-width:39px}.oc-process-list strong{font-size:21px;line-height:1.3}.oc-process-list p{color:#b8c3d1;font-size:13px;line-height:1.5;margin:6px 0 0}
.oc-pricing{background:#fbfaf6;padding:105px 0 95px}.oc-pricing-intro{display:grid;grid-template-columns:.35fr 1fr;gap:65px;margin-bottom:47px}.oc-pricing-intro p:not(.oc-label-dark){max-width:670px;line-height:1.7;color:#6f7883}.oc-price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.oc-plan{min-height:390px;display:flex;flex-direction:column;justify-content:space-between;background:#fff;border:1px solid #d5dcd9;padding:29px;transition:transform .15s}.oc-plan:hover{transform:translateY(-4px)}.oc-plan-middle{background:#edeeff;border-color:#9f99e2}.oc-plan-index{font-size:10px;letter-spacing:.14em;font-weight:800;color:#5f51a1}.oc-plan h3{font-size:30px;margin:38px 0 12px}.oc-plan p{font-size:14px;color:#61707c;line-height:1.65;min-height:67px}.oc-plan-cost{display:flex;gap:12px;align-items:center;padding-top:25px;border-top:1px solid #dfe3e6}.oc-plan-cost strong{font-size:46px;letter-spacing:-.05em}.oc-plan-cost span{font-size:12px;line-height:1.45;color:#65707d}.oc-plan-bottom small{display:block;font-size:11px;color:#667480;margin:12px 0 20px}.oc-plan-bottom>a{display:flex;justify-content:space-between;font-size:12px;font-weight:800;background:#252346;color:#fff;padding:16px}.oc-plan-bottom>a:hover{background:#523ab6}.oc-price-disclaimer{font-size:12px;color:#697580;line-height:1.6;margin-top:22px}.oc-price-disclaimer a{color:#4b34ac;text-decoration:underline}
.oc-guides{background:#f0f3f0;padding:90px 0}.oc-guides-layout{display:grid;grid-template-columns:1fr 1fr;gap:100px}.oc-guides h2{margin:20px 0 18px}.oc-guides p:not(.oc-label-dark){font-size:15px;line-height:1.7;color:#68767c;max-width:430px}.oc-guide-links{border-top:1px solid #b9c9c7}.oc-guide-links a{display:grid;grid-template-columns:115px 1fr 25px;align-items:center;gap:18px;border-bottom:1px solid #b9c9c7;padding:25px 0;color:#19243a}.oc-guide-links a:hover{color:#5036b9}.oc-guide-links a>span:first-child{font-size:10px;letter-spacing:.1em;color:#467572;font-weight:800}.oc-guide-links a strong{font-size:16px}
.oc-final{background:#aee3d9;padding:85px 0}.oc-final-grid{display:flex;align-items:end;justify-content:space-between;gap:35px}.oc-final p{font-size:11px;font-weight:850;letter-spacing:.16em;color:#24645f}.oc-final h2{max-width:770px;margin:20px 0 0}.oc-final a{white-space:nowrap;display:flex;align-items:center;gap:30px;background:#1b263b;color:#fff;padding:19px 22px;font-size:13px;font-weight:800}.oc-final a:hover{background:#4f35ad}
