---
import Base from '../layouts/Base.astro'
const schema = {
  "@context":"https://schema.org",
  "@type":"SoftwareApplication",
  "name":"Oculivo",
  "applicationCategory":"BusinessApplication",
  "operatingSystem":"Web",
  "url":"https://oculivo.com/",
  "description":"Eye care practice management software for optometry and ophthalmology practices."
}
---
<Base>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero"><div class="wrap grid">
  <div>
    <span class="eyebrow">Eye care practice management</span>
    <h1>One connected workspace for the entire eye-care practice.</h1>
    <p>Scheduling, patients, clinical records, optical inventory, insurance, billing, communications, documents, staff workflows, and reporting — built around how optometry and ophthalmology teams actually work.</p>
    <div class="actions"><a class="btn primary" href="https://taxrescrm.app/book?product=oculivo">Book a demo →</a><a class="btn secondary" href="https://app.oculivo.com">Sign in</a></div>
  </div>
  <div class="panel"><b>Oculivo Core Connect</b><div class="metric"><span>Today</span><strong>Practice command center</strong></div><div class="rows"><span>Appointments & scheduling</span><span>Patient & clinical workflows</span><span>Optical inventory & orders</span><span>Insurance, billing & payments</span><span>Unified communications</span><span>Team Chat & staff operations</span></div></div>
</div></section>
<section class="section"><div class="wrap"><span class="eyebrow">Designed for eye care</span><h2>Stop forcing generic software into specialty workflows.</h2><div class="cards"><article><span class="num">1.</span><h3>Front desk</h3><p>Booking, intake, reminders, communications, documents, payments, and patient coordination stay in one place.</p></article><article><span class="num">2.</span><h3>Clinical team</h3><p>Patient context, encounters, records, care workflows, provider schedules, and secure documents stay connected.</p></article><article><span class="num">3.</span><h3>Optical & billing</h3><p>Inventory, optical orders, claims, invoices, payments, and office reporting connect to the same patient history.</p></article></div></div></section>
</main>
</Base>
<style>
.hero{padding:96px 0 84px;background:radial-gradient(circle at 76% 28%,rgba(92,68,210,.22),transparent 34%),#0b0b22;color:white;min-height:610px}.grid{display:grid;grid-template-columns:1.08fr .92fr;gap:70px;align-items:center}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;font-weight:850;color:#9183ff}.hero h1{font-size:clamp(48px,6vw,76px);line-height:.98;letter-spacing:-.055em;margin:20px 0 24px;max-width:760px}.hero p{font-size:18px;line-height:1.75;color:#b8b6cd;max-width:690px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}.panel{background:linear-gradient(160deg,#211957,#171438);border:1px solid #3a3371;border-radius:28px;padding:30px;box-shadow:0 35px 90px rgba(0,0,0,.35);min-height:420px}.panel>b{font-size:14px;letter-spacing:.02em}.metric{margin-top:26px;padding:24px 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:7px}.metric span,.rows span{color:#b9b5db}.metric strong{font-size:22px}.rows{display:grid;gap:14px;padding-top:22px;font-size:14px}.section{padding:92px 0;background:#101028}.section h2{font-size:clamp(36px,4.4vw,58px);line-height:1.05;letter-spacing:-.045em;max-width:820px;margin:16px 0 40px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.cards article{background:#171438;border:1px solid #2e2957;border-radius:24px;padding:28px;min-height:240px}.cards article:first-child{background:#211957;border-color:#463b8b}.num{display:block;color:#a695ff;font-size:30px;font-weight:900;margin-bottom:28px}.cards h3{font-size:22px;margin:0 0 10px}.cards p{line-height:1.7;color:#aaa8c6;margin:0}@media(max-width:820px){.grid,.cards{grid-template-columns:1fr}.hero{padding:64px 0}.panel{min-height:auto}.section{padding:64px 0}}
</style>
