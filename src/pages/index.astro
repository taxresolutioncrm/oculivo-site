---
import Base from '../layouts/Base.astro'
const schema={"@context":"https://schema.org","@type":"SoftwareApplication","name":"Oculivo","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://oculivo.com/","description":"The operating system for modern eye care."}
---
<Base>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<main>
<section class="hero-dark home-hero">
  <div class="wrap home-grid">
    <div class="home-copy">
      <span class="eyebrow home-purple">One connected eye-care platform</span>
      <h1>The operating<br/>system for<br/>modern eye<br/>care.</h1>
      <p>Oculivo connects scheduling, patients, clinical workflows, optical, communications, billing, staff operations, website, SEO, and reporting in one practice-wide system.</p>
      <div class="hero-actions left">
        <a class="btn-grad" href="https://taxrescrm.app/book?product=oculivo">Request a private demo&nbsp; →</a>
        <a class="btn-outline" href="/website-seo/">Explore Oculivo</a>
      </div>
    </div>
    <aside class="home-panel">
      <span class="eyebrow">Oculivo Core Connect</span>
      <h2>One patient record.<br/>One connected practice.</h2>
      <div class="panel-list">
        <b>Schedule + intake</b>
        <b>Clinical + optical</b>
        <b>Communications + billing</b>
        <b>Team + growth</b>
      </div>
    </aside>
  </div>
</section>

<section class="section-light depth-section">
  <div class="wrap">
    <div class="depth-top">
      <span class="eyebrow">One connected platform</span>
      <div class="depth-title">
        <h2>Purpose-built depth.<br/>Practice-wide clarity.</h2>
        <p>Oculivo connects every workflow to the same patient and practice context so your team can move from front desk to clinical, optical, communications, billing, and growth without rebuilding the story in disconnected systems.</p>
      </div>
    </div>
    <div class="depth-cards">
      <article class="depth-card"><span class="num">01</span><h3>Front desk + patient flow</h3><p>Scheduling, intake, communication, reminders, documents, and patient coordination stay connected.</p><small>◉&nbsp;&nbsp;Connected to the complete patient record</small></article>
      <article class="depth-card"><span class="num">02</span><h3>Clinical + optical</h3><p>Clinical records, provider workflows, optical inventory, orders, and fulfillment share the same patient context.</p><small>◉&nbsp;&nbsp;Connected to the complete patient record</small></article>
      <article class="depth-card"><span class="num">03</span><h3>Growth + operations</h3><p>Billing, reporting, communications, website, SEO, and staff operations connect to the work happening in the practice.</p><small>◉&nbsp;&nbsp;Connected to the complete patient record</small></article>
    </div>
  </div>
</section>

<section class="founding-section">
  <div class="wrap">
    <div class="founding-card">
      <div>
        <span class="eyebrow">Founding practice program</span>
        <h2>Build the clearer future of eye care<br/>with us.</h2>
        <p>Get a private walkthrough and help shape Oculivo around the workflows your practice actually uses.</p>
      </div>
      <a class="btn-white" href="https://taxrescrm.app/book?product=oculivo">Request your private demo&nbsp; →</a>
    </div>
  </div>
</section>
</main>
</Base>
<style>
.home-hero{padding:94px 0 96px;min-height:706px}
.home-grid{display:grid;grid-template-columns:1.03fr .97fr;gap:78px;align-items:center}
.home-copy{padding-top:4px}
.home-purple{color:#825cff}
.home-hero h1{font-size:clamp(64px,6.4vw,92px);line-height:.92;letter-spacing:-.06em;font-weight:650;margin:24px 0 24px}
.home-hero p{font-size:17px;line-height:1.75;color:#d1cde4;max-width:700px;margin:0}
.hero-actions.left{justify-content:flex-start}
.home-panel{background:#2a1f6b;border:1px solid #634ec0;border-radius:26px;padding:40px 36px;min-height:420px;box-shadow:0 28px 70px rgba(3,3,19,.28)}
.home-panel h2{font-size:36px;line-height:1.06;letter-spacing:-.035em;font-weight:650;margin:36px 0 30px}
.panel-list{border-top:1px solid rgba(255,255,255,.15);padding-top:25px;display:grid;gap:17px}
.panel-list b{font-size:15px;color:#fff}
@media(max-width:900px){.home-grid{grid-template-columns:1fr}.home-hero h1 br{display:none}}
</style>