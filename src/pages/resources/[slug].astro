---
import Base from '../../layouts/Base.astro'
import { seoResources } from '../../data/seoResources'
export function getStaticPaths(){ return seoResources.map((resource)=>({params:{slug:resource.slug},props:{resource}})) }
const { resource } = Astro.props
const canonical=`https://oculivo.com/resources/${resource.slug}/`
const schema=[
 {'@context':'https://schema.org','@type':'Article','headline':resource.title,'description':resource.description,'datePublished':'2026-09-16','dateModified':'2026-09-16','author':{'@type':'Organization','name':'Oculivo'},'publisher':{'@type':'Organization','name':'Oculivo','url':'https://oculivo.com'},'mainEntityOfPage':canonical},
 {'@context':'https://schema.org','@type':'FAQPage','mainEntity':resource.faq.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))}
]
---
<Base title={`${resource.title} | Oculivo`} description={resource.description} schema={schema}>
<main>
<section class="hero-dark page-hero"><div class="wrap"><span class="eyebrow">{resource.eyebrow}</span><h1>{resource.h1}</h1><p>{resource.intro}</p><div class="hero-actions"><a class="btn-grad" href="https://taxrescrm.app/book?product=oculivo">Request a private demo&nbsp; →</a><a class="btn-outline" href="/resources/">Browse resources</a></div></div></section>
<section class="section-light"><div class="wrap article-wrap"><div class="quick"><strong>Quick answer:</strong> {resource.intro}</div>
{resource.sections.map(([heading,body]) => <section class="article-section"><h2>{heading}</h2><p>{body}</p></section>)}
<section class="faq-block"><span class="eyebrow">FAQ</span><h2>Frequently asked questions</h2>{resource.faq.map(([q,a]) => <article><h3>{q}</h3><p>{a}</p></article>)}</section>
</div></section>
<section class="founding-section"><div class="wrap"><div class="founding-card"><div><span class="eyebrow">See the workflow</span><h2>Connect the patient, clinical and optical record.</h2><p>See how Oculivo keeps practice operations connected without flattening specialty workflows.</p></div><a class="btn-white" href="https://taxrescrm.app/book?product=oculivo">Request your private demo&nbsp; →</a></div></div></section>
</main></Base>
<style>.article-wrap{max-width:820px;margin:auto;padding-top:5rem;padding-bottom:5rem}.quick{padding:1.2rem 1.4rem;border-left:3px solid #7c3aed;background:#f5f3ff;color:#334155;line-height:1.7;margin-bottom:2rem}.article-section{padding:1rem 0 1.4rem;border-bottom:1px solid rgba(15,23,42,.08)}.article-section h2,.faq-block h2{font-size:clamp(1.55rem,2.7vw,2.2rem);margin:1rem 0;color:#0f172a}.article-section p,.faq-block p{font-size:1.02rem;line-height:1.8;color:#475569}.faq-block{padding-top:2.5rem}.faq-block article{padding:1.15rem 0;border-bottom:1px solid rgba(15,23,42,.08)}.faq-block h3{font-size:1.05rem;color:#0f172a;margin:0 0 .5rem}</style>
