const schema=[
  {"@context":"https://schema.org","@type":"SoftwareApplication","name":"Oculivo","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://oculivo.com/ophthalmology-software/","description":"Cloud-based ophthalmology practice management software connecting provider scheduling, patient workflows, documents, billing, communications, staff operations and reporting."},
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {"@type":"Question","name":"What should ophthalmology practice management software support?","acceptedAnswer":{"@type":"Answer","text":"Common needs include provider scheduling, patient records, clinical workflow support, referrals, documents, insurance and billing, communication, staff coordination and reporting."}},
