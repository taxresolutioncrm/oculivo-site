---
import Base from '../../layouts/Base.astro'
---
<Base title="Oculivo CRM Tour | See the Product" description="See Oculivo CRM screens for practice overview, patients, clinical workflows, communications, billing, and operations." hideDemoCta={true}>
<main class="tour-page">
  <section class="tour-hero hero-dark">
    <div class="wrap tour-hero-grid">
      <div>
        <span class="eyebrow">90-second product tour</span>
        <h1>See Oculivo<br/>before you book.</h1>
        <p>Browse real Oculivo CRM workflows first. No form, no sales gate—just a clear look at how the practice workspace comes together.</p>
      </div>
      <div class="tour-nav-card">
        <span>Included in this tour</span>
        <a href="#overview">01 &nbsp; Practice overview</a>
        <a href="#patients">02 &nbsp; Patient workspace</a>
        <a href="#clinical">03 &nbsp; Clinical records</a>
        <a href="#operations">04 &nbsp; Connected operations</a>
      </div>
    </div>
  </section>

  <section class="tour-gallery section-light">
    <div class="wrap tour-stack">
      <article class="tour-shot" id="overview">
        <header><div><span>01</span><h2>Practice overview</h2></div><p>Live practice counts, patient flow, conversations, staff time, and connected practice status.</p></header>
        <figure class="real-crm-shot"><img src="/tour/overview.jpg" alt="Oculivo CRM practice overview screen" loading="lazy"/></figure>
      </article>

      <article class="tour-shot" id="patients">
        <header><div><span>02</span><h2>Patient workspace</h2></div><p>Open a patient profile, review contact data and linked history, then move directly into scheduling, clinical, optical, billing, or documents.</p></header>
        <figure class="real-crm-shot"><img src="/tour/patients.jpg" alt="Oculivo CRM patients screen" loading="lazy"/></figure>
      </article>

      <article class="tour-shot" id="clinical">
        <header><div><span>03</span><h2>Clinical records</h2></div><p>Eye-care-specific charting with acuity, IOP, assessment context, draft/sign status, and provider workflow.</p></header>
        <figure class="real-crm-shot"><img src="/tour/clinical.jpg" alt="Oculivo CRM clinical records screen" loading="lazy"/></figure>
      </article>

      <article class="tour-ops" id="operations">
        <span class="eyebrow">Connected operations</span>
        <h2>One sidebar. The whole practice.</h2>
        <div class="ops-grid"><b>Schedule</b><b>Patients</b><b>Clinical</b><b>Optical</b><b>Inbox</b><b>Phone</b><b>Team Chat</b><b>Timeclock</b><b>Billing</b><b>Documents</b><b>Reports</b><b>Manual</b><b>Support</b></div>
        <div class="tour-actions"><a class="btn-outline" href="/">Back to Oculivo</a></div>
      </article>
    </div>
  </section>
</main>
<style>
.tour-hero{padding:86px 0 92px}.tour-hero-grid{display:grid;grid-template-columns:1.15fr .72fr;gap:90px;align-items:end}.tour-hero h1{font-size:clamp(62px,6.2vw,88px);line-height:.92;letter-spacing:-.06em;font-weight:560;margin:24px 0}.tour-hero p{max-width:690px;color:#cac6df;font-size:17px;line-height:1.7}.tour-nav-card{background:#20175b;border:1px solid #52429b;border-radius:22px;padding:28px;display:grid;gap:10px}.tour-nav-card>span{font-size:11px;color:#8e85bd;text-transform:uppercase;letter-spacing:.14em;font-weight:900;margin-bottom:6px}.tour-nav-card a{text-decoration:none;color:#fff;border-top:1px solid rgba(255,255,255,.1);padding:13px 0 3px;font-size:14px}.tour-gallery{padding:68px 0 100px}.tour-stack{display:grid;gap:76px}.tour-shot>header{display:grid;grid-template-columns:.82fr 1.18fr;gap:60px;align-items:end;margin-bottom:24px}.tour-shot>header>div{display:flex;align-items:baseline;gap:16px}.tour-shot>header span{color:#7852ed;font-size:12px;font-weight:900}.tour-shot h2,.tour-ops h2{font-size:clamp(36px,4vw,54px);line-height:1;letter-spacing:-.045em;font-weight:560;margin:0}.tour-shot>header p{color:#69677c;font-size:15px;line-height:1.65;margin:0}.real-crm-shot{margin:0;background:#fff;border:1px solid #d9d9e6;border-radius:22px;overflow:hidden;box-shadow:0 28px 70px rgba(35,30,78,.12)}.real-crm-shot img{display:block;width:100%;height:auto}.browser-top{height:42px;background:#f7f7fb;border-bottom:1px solid #e3e3ec;display:flex;align-items:center;gap:7px;padding:0 15px;color:#8b8999;font-size:10px}.browser-top i{width:8px;height:8px;border-radius:50%;background:#dad8e5}.browser-top span{margin-left:8px}.crm-frame{display:grid;grid-template-columns:155px 1fr;min-height:560px;background:#f5f6fa}.mini-sidebar{background:#0b0b22;color:#f5f4ff;padding:18px 12px;display:grid;align-content:start;gap:10px}.mini-logo{color:#6e42ff;font-size:12px;margin-bottom:8px}.mini-sidebar small{font-size:7px;letter-spacing:.15em;color:#75718e;margin-top:8px}.mini-sidebar b{font-size:9px;padding:7px 8px;border-radius:7px}.mini-sidebar .active{background:#26345f;border:1px solid #3b5c96}.mini-main{padding:22px 24px}.mini-context{font-size:7px;letter-spacing:.16em;color:#9491a5;margin-bottom:24px}.mini-context strong{font-size:10px;letter-spacing:0;color:#202037;margin-left:6px}.mini-title span{font-size:7px;letter-spacing:.14em;color:#88849f;font-weight:900}.mini-title h3{font-size:24px;margin:9px 0 6px}.mini-title p{font-size:9px;color:#777489}.mini-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}.mini-metrics>div{background:#fff;border:1px solid #dedee9;border-radius:11px;padding:14px}.mini-metrics span{display:block;font-size:8px}.mini-metrics strong{display:block;font-size:23px;margin:12px 0 5px}.mini-metrics em{font-size:7px;color:#6841e9;font-style:normal;font-weight:800}.mini-split{display:grid;grid-template-columns:1.65fr .75fr;gap:10px}.mini-panel{background:#fff;border:1px solid #dedee9;border-radius:11px;overflow:hidden}.mini-panel>header{padding:12px;border-bottom:1px solid #ececf2;display:flex;justify-content:space-between;font-size:8px}.mini-panel>header span{color:#6944e9}.flow-row{display:grid;grid-template-columns:66px 1fr auto;gap:8px;align-items:center;padding:11px 12px;border-bottom:1px solid #eeeeF3;font-size:8px}.flow-row p{margin:0}.flow-row small{display:block;color:#858296;margin-top:3px}.flow-row em{background:#eee9ff;color:#6742d4;padding:4px 7px;border-radius:12px;font-style:normal;font-weight:800}.status-list p{display:flex;justify-content:space-between;padding:10px 12px;border-bottom:1px solid #eeeeF3;margin:0;font-size:8px}.status-list span{color:#888598}.patients-shot,.clinical-shot{padding:24px;background:#f5f6fa}.shot-head{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #dedee9;border-radius:12px;padding:15px;margin-bottom:14px}.shot-head h3{font-size:20px;margin:0}.shot-head p{font-size:9px;color:#777489;margin:4px 0 0}.shot-head button{border:0;background:#7240ee;color:#fff;border-radius:9px;padding:11px 15px;font-size:9px;font-weight:800}.patient-demo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.patient-demo-card,.clinical-demo-card{background:#fff;border:1px solid #dedee9;border-radius:12px;padding:14px}.demo-patient-head{display:grid;grid-template-columns:38px 1fr auto;gap:9px;align-items:center;margin-bottom:14px}.demo-patient-head i{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#2fd6d4,#7840f0);display:grid;place-items:center;color:#fff;font-style:normal;font-size:10px;font-weight:900}.demo-patient-head p{margin:0}.demo-patient-head b{font-size:10px}.demo-patient-head small{display:block;font-size:7px;color:#7e7b90;margin-top:3px}.demo-patient-head em,.clinical-demo-card em{font-style:normal;background:#eee9ff;color:#6842d6;border-radius:12px;padding:5px 7px;font-size:8px;font-weight:800}.patient-demo-card>span{display:block;font-size:8px;color:#676478;margin:7px 0}.patient-demo-card footer{display:flex;justify-content:space-between;border-top:1px solid #efeff4;margin:12px -14px -14px;padding:10px 14px;font-size:8px;color:#6842d6}.clinical-demo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.clinical-demo-card header{display:flex;justify-content:space-between;align-items:center}.clinical-demo-card header b{font-size:10px}.clinical-demo-card>p{font-size:8px;color:#6f6b80}.clinical-demo-card>div{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.clinical-demo-card>div span{background:#f5f4fa;padding:8px;border-radius:7px;color:#88849a;font-size:7px}.clinical-demo-card>div b{display:block;color:#171629;font-size:8px;margin-top:3px}.clinical-demo-card footer{border-top:1px solid #efeff4;margin-top:10px;padding-top:9px;font-size:8px}.tour-ops{background:#0d0c25;color:#fff;border-radius:26px;padding:54px}.tour-ops h2{margin:16px 0 30px}.ops-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.ops-grid b{border:1px solid #353250;background:#16152f;border-radius:10px;padding:15px;font-size:12px}.tour-actions{display:flex;gap:12px;margin-top:34px}
@media(max-width:900px){.tour-hero-grid,.tour-shot>header{grid-template-columns:1fr}.crm-frame{grid-template-columns:1fr}.mini-sidebar{display:none}.mini-metrics{grid-template-columns:repeat(2,1fr)}.mini-split{grid-template-columns:1fr}.patient-demo-grid,.clinical-demo-grid{grid-template-columns:1fr}.ops-grid{grid-template-columns:repeat(2,1fr)}}
</style>
</Base>
